# Ruflo Email Manager — Credentials Template
# Copy this to ~/credentials/.env and fill in your values.
# NEVER commit the real .env file.

N8N_BASE_URL=https://n8n.yielded.io
N8N_API_KEY=your_n8n_api_key_here

# These must match the credential names in your n8n instance exactly.
# Find them at: n8n → Credentials (left sidebar)
GMAIL_CREDENTIAL_NAME=Gmail account
GCAL_CREDENTIAL_NAME=Google Calendar account
ANTHROPIC_CREDENTIAL_NAME=Anthropic account
