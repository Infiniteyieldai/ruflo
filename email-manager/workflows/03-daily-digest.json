{
  "name": "03 - Daily Email Digest",
  "nodes": [
    {
      "id": "digest-001",
      "name": "Every Morning at 7am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * 1-5"
            }
          ]
        }
      }
    },
    {
      "id": "digest-002",
      "name": "Fetch Yesterday's Emails",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [440, 300],
      "parameters": {
        "operation": "getAll",
        "returnAll": false,
        "limit": 50,
        "filters": {
          "q": "after:{{ Math.floor((Date.now() - 86400000) / 1000) }} in:inbox"
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_GMAIL_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    },
    {
      "id": "digest-003",
      "name": "Format Email List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300],
      "parameters": {
        "jsCode": "const emails = $input.all().map(item => item.json);\nif (!emails.length) {\n  return [{ json: { skip: true, count: 0, summary: 'No emails to summarise.' } }];\n}\nconst formatted = emails.map((e, i) =>\n  `${i + 1}. From: ${e.from || 'Unknown'}\\n   Subject: ${e.subject || '(no subject)'}\\n   Preview: ${(e.snippet || '').slice(0, 150)}`\n).join('\\n\\n');\nreturn [{ json: { skip: false, count: emails.length, emailList: formatted } }];"
      }
    },
    {
      "id": "digest-004",
      "name": "Skip if No Emails",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [920, 300],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "cond-skip",
              "leftValue": "={{ $json.skip }}",
              "rightValue": false,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ]
        }
      }
    },
    {
      "id": "digest-005",
      "name": "Claude - Summarise & Prioritise",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1160, 200],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $env.ANTHROPIC_API_KEY }}" },
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-haiku-4-5-20251001\",\n  \"max_tokens\": 600,\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": \"You are an executive assistant. Summarise these {{ $json.count }} emails into a concise daily briefing. Group by priority (urgent → action needed → FYI). Use bullet points. Be brief.\\n\\nEmails:\\n{{ $json.emailList }}\"\n  }]\n}"
      }
    },
    {
      "id": "digest-006",
      "name": "Build Digest Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1400, 200],
      "parameters": {
        "jsCode": "const summary = $input.first().json.content?.[0]?.text || 'No summary available.';\nconst count = $('Format Email List').first().json.count;\nconst today = new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });\nconst html = `\n<h2>📬 Daily Email Digest — ${today}</h2>\n<p><strong>${count} emails</strong> received since yesterday.</p>\n<hr>\n<h3>AI Summary</h3>\n<pre style=\"font-family:inherit;white-space:pre-wrap\">${summary}</pre>\n<hr>\n<p style=\"color:#888;font-size:12px\">Generated by Ruflo Email Manager</p>\n`;\nreturn [{ json: { subject: `Daily Digest — ${today} (${count} emails)`, html } }];"
      }
    },
    {
      "id": "digest-007",
      "name": "Send Digest to Myself",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1640, 200],
      "parameters": {
        "operation": "send",
        "sendTo": "me",
        "subject": "={{ $json.subject }}",
        "message": "={{ $json.html }}",
        "options": {
          "isBodyHtml": true
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_GMAIL_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    }
  ],
  "connections": {
    "Every Morning at 7am": {
      "main": [[{ "node": "Fetch Yesterday's Emails", "type": "main", "index": 0 }]]
    },
    "Fetch Yesterday's Emails": {
      "main": [[{ "node": "Format Email List", "type": "main", "index": 0 }]]
    },
    "Format Email List": {
      "main": [[{ "node": "Skip if No Emails", "type": "main", "index": 0 }]]
    },
    "Skip if No Emails": {
      "main": [
        [{ "node": "Claude - Summarise & Prioritise", "type": "main", "index": 0 }],
        []
      ]
    },
    "Claude - Summarise & Prioritise": {
      "main": [[{ "node": "Build Digest Email", "type": "main", "index": 0 }]]
    },
    "Build Digest Email": {
      "main": [[{ "node": "Send Digest to Myself", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "email-manager" }, { "name": "digest" }, { "name": "ai" }]
}
