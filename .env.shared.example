# .env.shared — Shared credentials for Ruflo + n8n integration
# Copy this file to .env.shared and fill in your values.
# .env.shared is git-ignored; never commit actual secrets.

# ── Anthropic ──────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── n8n ────────────────────────────────────────────────────
# URL of your n8n instance (local or cloud)
N8N_BASE_URL=http://localhost:5678
# n8n REST API key (Settings → API → Create API Key in n8n UI)
N8N_API_KEY=your-n8n-api-key

# ── OpenAI (optional, for Codex workers) ───────────────────
OPENAI_API_KEY=your-openai-api-key

# ── Pinata / IPFS (optional, for plugin registry) ──────────
PINATA_API_KEY=your-pinata-api-key
PINATA_JWT=your-pinata-jwt

# ── Add additional service credentials below ────────────────
# The n8n/env/update MCP tool writes new credentials here automatically.
